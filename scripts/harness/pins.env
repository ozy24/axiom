# Pinned versions the game tests run against. Change only in a reviewed PR,
# then run scripts/jumpbox/install-engines.sh on the jumpbox.
#
# Q2RED: main with PR #105 (file access for the game module, ledger A62),
# #104 (1024-byte paths, A61) and #103 (module lobby discovery, A60).
Q2RED_COMMIT=13daec66
# Q2REX: Windows server under Wine, for running the MSVC game_x64.dll.
# 0.15.1 rather than the newest 0.15.2 (three days old when pinned).
Q2REX_VERSION=0.15.1
# ozbot-re: main, bot cvars on the rerelease's scale.
OZBOT_COMMIT=c93c69f9
# The stock reference: unmodified id code with this repo's build system. The
# `stock-reference` tag must always point here; game-tests fails if it moves.
STOCK_REFERENCE_COMMIT=a44e2d63b772889c23c360297d87e5133e812406
# SHA-256 of the stock-reference release asset (MSVC build of a44e2d63).
STOCK_REFERENCE_DLL_SHA256=5ab4f335645d4a774f2082e3a59e92a4139c255b19f0c44a9026ed23337e9a8e
